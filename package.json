{
  "name": "unifi-secure-mcp",
  "version": "0.2.0",
  "description": "Local-first UniFi Network MCP with complete versioned API coverage, pinned TLS, and guarded writes.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "unifi-secure-mcp": "src/cli.mjs"
  },
  "scripts": {
