    "setup": "node src/cli.mjs setup",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "verify": "node scripts/verify.mjs",
    "privacy": "node scripts/privacy.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
